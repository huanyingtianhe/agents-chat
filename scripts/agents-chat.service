[Unit]
Description=Agents-Chat (Next.js multi-agent chat UI)
Documentation=https://github.com/huanyingtianhe/agents-chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__

# Load project env (KEY=VALUE per line). Leading '-' = file is optional.
# Next.js also auto-loads .env.local at runtime; this line makes the same
# values available to systemd / Node before the process starts.
EnvironmentFile=-__PROJECT_DIR__/.env.local

# Optional machine-level overrides (takes precedence over .env.local)
EnvironmentFile=-/etc/agents-chat.env

Environment=NODE_ENV=production
Environment="PATH=__NODE_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# The preflight and server use the same validated absolute Node executable.
ExecStartPre="__NODE__" "__PROJECT_DIR__/scripts/runtime-preflight.mjs" check-only --project-root "__PROJECT_DIR__"
ExecStart="__NODE__" "__PROJECT_DIR__/scripts/start-server.mjs"

Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agents-chat

# Light sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
